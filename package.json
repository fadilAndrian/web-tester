{
  "name": "qa-desktop-app",
  "version": "1.0.0",
  "description": "Desktop Web Test Automation Runner & Orchestrator",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:server": "cross-env NODE_ENV=development node --watch server.cjs",
    "dev": "concurrently -k -n \"server,vite,electron\" -c \"blue,green,magenta\" \"node --watch server.cjs\" \"vite --port 5173\" \"cross-env NODE_ENV=development electron .\"",
    "dev:web": "concurrently -k -n \"server,vite\" -c \"blue,green\" \"node --watch server.cjs\" \"vite --port 5173\"",
    "build": "vite build",
    "build:web": "cross-env VITE_APP_MODE=web vite build",
    "serve": "cross-env NODE_ENV=production node server.cjs",
    "start:server": "node server.cjs",
    "start": "electron ."
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "electron"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  }
}
