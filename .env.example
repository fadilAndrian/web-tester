# QA Flow Studio Environment Configuration

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Automation Runner Settings
# Set to true for headless Linux server / Docker environments
FORCE_HEADLESS=true

# Database Configuration (PostgreSQL)
# Option A: Full Connection String (Recommended for Cloud Providers: Neon, Supabase, Render, Railway, AWS RDS)
DATABASE_URL=postgresql://qa_user:qa_password@localhost:5432/qa_flow_studio

# Option B: Individual Connection Parameters
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=konnco
# PGPASSWORD=
# PGDATABASE=qa_flow_studio
# PGSSL=false
